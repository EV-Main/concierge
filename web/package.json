{
  "name": "@evconcierge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The identity plane's microfrontends: <mfe-concierge-sign-in>, <mfe-concierge-account>, <mfe-concierge-account-chip>, <mfe-concierge-reauth> and <mfe-concierge-stepup>. Self-registering ESM bundles with their own React, built to dist/ and served by concierge under /auth/mfe/*.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "i18n:extract": "evinvest-i18n-extract --root . --exclude dist,messages,scripts,styles",
    "i18n:check": "evinvest-i18n-check --root . --exclude dist,messages,scripts,styles"
  },
  "dependencies": {
    "@evinvest/i18n": "^0.11.0",
    "@evinvest/mfe": "^0.3.0",
    "@evinvest/uikit": "^0.29.1",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/cli": "^4.1.14",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  }
}
